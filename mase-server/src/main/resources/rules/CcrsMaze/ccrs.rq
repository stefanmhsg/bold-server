PREFIX dyn:  <https://paul.ti.rw.fau.de/~am52etar/dynmaze/dynmaze#>
PREFIX maze: <https://kaefer3000.github.io/2021-02-dagstuhl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX ldp: <http://www.w3.org/ns/ldp#>
PREFIX sm:   <https://example.org/stigmark#>
PREFIX ui:   <https://example.org/ui#>

# Mark the location of the keys
INSERT {
  GRAPH ?gg {
    ?cellg ui:hasUiElement ?uigreenkey .

    ?uigreenkey ui:konvaType "Circle";
      ui:layer "layer";
      ui:anchor "SE";
      ui:offsetX 0;
      ui:offsetY 0;
      ui:width 12;
      ui:height 12;
      ui:fill "green";
      ui:stroke "black";
      ui:strokeWidth 1 .
  }
  GRAPH ?gb {
    ?cellb ui:hasUiElement ?uibluekey .

    ?uibluekey ui:konvaType "Circle";
      ui:layer "layer";
      ui:anchor "SE";
      ui:offsetX 0;
      ui:offsetY 0;
      ui:width 12;
      ui:height 12;
      ui:fill "blue";
      ui:stroke "black";
      ui:strokeWidth 1 .
  }
  GRAPH ?gr {
    ?cellr ui:hasUiElement ?uiredkey .

    ?uiredkey ui:konvaType "Circle";
      ui:layer "layer";
      ui:anchor "SE";
      ui:offsetX 0;
      ui:offsetY 0;
      ui:width 12;
      ui:height 12;
      ui:fill "red";
      ui:stroke "black";
      ui:strokeWidth 1 .
  }
}
WHERE {
  # green
  GRAPH ?gg {
    ?cellg a maze:Cell .
    ?greeniri dyn:keyValue "greenkey" .
  }
  BIND(IRI(CONCAT(STR(?cellg), "#ui-greenkey")) AS ?uigreenkey)    
  # blue
  GRAPH ?gb {
    ?cellb a maze:Cell .
    ?blueiri dyn:keyValue "bluekey" .
  }
  BIND(IRI(CONCAT(STR(?cellb), "#ui-bluekey")) AS ?uibluekey)
  # red
  GRAPH ?gr {
    ?cellr a maze:Cell .
    ?rediri dyn:keyValue "redkey" .
  }
  BIND(IRI(CONCAT(STR(?cellr), "#ui-redkey")) AS ?uiredkey)
} ;

# --------------
# SIGNIFIER ZONE
# --------------

# Remove Signifiers outside of the signifier-zone
DELETE {
    GRAPH ?g {
        ?cell maze:green ?target .
    }
}
WHERE {
    GRAPH ?g {
        ?cell a maze:Cell .
        ?cell maze:green ?target .
    }
    BIND(STRAFTER(STR(?cell), "/cells/") AS ?coords)
    FILTER(CONTAINS(?coords, "/"))  # keep only /cells/x/y
  
    BIND(xsd:integer(STRBEFORE(?coords, "/")) AS ?x)
    BIND(xsd:integer(STRAFTER(?coords, "/")) AS ?y)
  
    
    FILTER(
        # delete beyond reference cell /cells/12/5
        (?x > 12 || ?y > 5)
        &&
        # except the mixed zone
        !(
          (
            (
            # Base Frame 1
            (
                ?x > 27 && ?x < 41 &&
                ?y > 13 && ?y < 37
            ) ||
            # Base Frame 2
            (
                ?x >= 22 && 
                ?x <= 27 && 
                ?y >= 12 && 
                ?y <= 16
            )
            ) &&
            # Exclude
            ?coords NOT IN ("40/28", "40/30", "40/36", "28/20", "28/21", "29/21", "28/22", "28/35") 
          )
          # Include
          ||
          ?coords IN ("33/37") 
        )
    )
} ;

# Set Cell Background Color
INSERT {
    GRAPH ?g {
        ?cell ui:hasUiElement ?cellColor .

        ?cellColor ui:layer "cellBackground" ;
                             ui:fill "#e9ffdb" .
    }
}
WHERE {
    GRAPH ?g {
        ?cell a maze:Cell .
    }
    BIND(IRI(CONCAT(STR(?cell), "#ui-bg")) AS ?cellColor)

    # limit to zone
    BIND(STRAFTER(STR(?g), "/cells/") AS ?coords)
    FILTER(CONTAINS(?coords, "/"))  # keep only x/y
  
    BIND(xsd:integer(STRBEFORE(?coords, "/")) AS ?x)
    BIND(xsd:integer(STRAFTER(?coords, "/")) AS ?y)
  
    FILTER(
      (
        # Base Frame
        ?x < 13 &&
        ?y < 19 &&
        # Exclude
        ?coords NOT IN ("12/12", "12/14") 
      )
      # Include
      ||
      ?coords IN ("5/19", "4/19", "13/16", "13/17", "13/18") 
    )
} ;

# --------------
# STIGMERGY ZONE
# --------------

# stigmergy-traffic-increment: increment the counter
DELETE {
    # Remove old quantitative count
    GRAPH ?oldGraph {
        ?subnode sm:quantitative ?count .
    }
}
INSERT {
    # Update existing marker subnode with incremented count
    GRAPH ?oldGraph {
        ?subnode sm:quantitative ?newCount .
    }
}
WHERE {
    # the move event
    GRAPH ?targetGraph {
        ?agent dyn:entersFrom ?oldGraph .
    }

    # find the cell the agent is currently in
    GRAPH ?oldGraph {
        ?oldGraph maze:contains ?agent .

        # ensure marker does already exist
        ?oldGraph sm:hasMarker ?marker .
        
        # find existing subnode for this target
        ?marker sm:contains ?subnode .
        ?subnode sm:refersTo ?targetGraph .
        ?subnode sm:quantitative ?count .
    }

    BIND(?count + 1 AS ?newCount)

    # limit to zone
    BIND(STRAFTER(STR(?oldGraph), "/cells/") AS ?coords)
    FILTER(CONTAINS(?coords, "/"))  # keep only /cells/x/y
  
    BIND(xsd:integer(STRBEFORE(?coords, "/")) AS ?x)
    BIND(xsd:integer(STRAFTER(?coords, "/")) AS ?y)
  
    # starting at cell 13/5 and ending at cell 28/13 
    FILTER(
      (
        (
        # Base Frame 1
        (
            ?x > 12 && ?x < 29 &&
            ?y < 10
        ) ||
        # Base Frame 2
        (
            ?x > 20 && ?x < 29 &&
            ?y >= 10 && ?y < 12
        )
        ) &&
        # Exclude
        ?coords NOT IN ("") 
      )
      # Include
      ||
      ?coords IN ("28/12", "28/13") 
    )
} ;

# stigmergy-traffic-add: Add a direction to the existing marker
INSERT {
    # Origin Graph: Stigmergy marker creation
    GRAPH ?oldGraph {
        ?marker sm:contains _:node .
        _:node sm:refersTo ?targetGraph .
        _:node sm:quantitative 1 .
    }
}
WHERE {
    # the move event
    GRAPH ?targetGraph {
        ?agent dyn:entersFrom ?oldGraph .
    }

    # find the cell the agent is currently in
    GRAPH ?oldGraph {
        ?oldGraph maze:contains ?agent .

        # ensure marker does already exist
        ?oldGraph sm:hasMarker ?marker .
    }

    # ensure NO subnode for this target exists yet
    FILTER NOT EXISTS {
        GRAPH ?oldGraph{
            ?marker sm:contains ?anyNode .
            ?anyNode sm:refersTo ?targetGraph .
        }
    }  
    # limit to zone
    BIND(STRAFTER(STR(?oldGraph), "/cells/") AS ?coords)
    FILTER(CONTAINS(?coords, "/"))  # keep only /cells/x/y
  
    BIND(xsd:integer(STRBEFORE(?coords, "/")) AS ?x)
    BIND(xsd:integer(STRAFTER(?coords, "/")) AS ?y)
  
    # starting at cell 13/5 and ending at cell 28/13 
    FILTER(
      (
        (
        # Base Frame 1
        (
            ?x > 12 && ?x < 29 &&
            ?y < 10
        ) ||
        # Base Frame 2
        (
            ?x > 20 && ?x < 29 &&
            ?y >= 10 && ?y < 12
        )
        ) &&
        # Exclude
        ?coords NOT IN ("") 
      )
      # Include
      ||
      ?coords IN ("28/12", "28/13") 
    )
} ;

# Stigmergy-traffic-new: Create a marker within the stigmergy-zone. Start at 13/5 until 28/13 
INSERT {
    # Origin Graph: Stigmergy marker creation
    GRAPH ?oldGraph {
        ?oldGraph sm:hasMarker ?newMarker .
        ?newMarker a sm:Marker .
        ?newMarker sm:contains _:node .
        _:node sm:refersTo ?targetGraph .
        _:node sm:quantitative 1 .
    }
}
WHERE {
    # the move event
    GRAPH ?targetGraph {
        ?agent dyn:entersFrom ?oldGraph .
    }

    # find the cell the agent is currently in
    GRAPH ?oldGraph {
        ?oldGraph maze:contains ?agent .
        
        # ensure marker does NOT already exist
        FILTER NOT EXISTS { ?oldGraph sm:hasMarker ?anyMarker }        
    }
    
    # create new marker IRI
    BIND(IRI(CONCAT(STR(?oldGraph), "#marker")) AS ?newMarker)

    # limit to zone
    BIND(STRAFTER(STR(?oldGraph), "/cells/") AS ?coords)
    FILTER(CONTAINS(?coords, "/"))  # keep only /cells/x/y
  
    BIND(xsd:integer(STRBEFORE(?coords, "/")) AS ?x)
    BIND(xsd:integer(STRAFTER(?coords, "/")) AS ?y)
  
    # starting at cell 13/5 and ending at cell 28/13 
    FILTER(
      (
        (
        # Base Frame 1
        (
            ?x > 12 && ?x < 29 &&
            ?y < 10
        ) ||
        # Base Frame 2
        (
            ?x > 20 && ?x < 29 &&
            ?y >= 10 && ?y < 12
        )
        ) &&
        # Exclude
        ?coords NOT IN ("") 
      )
      # Include
      ||
      ?coords IN ("28/12", "28/13") 
    )
} ;


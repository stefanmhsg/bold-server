PREFIX dyn:  <https://paul.ti.rw.fau.de/~am52etar/dynmaze/dynmaze#>
PREFIX maze: <https://kaefer3000.github.io/2021-02-dagstuhl/vocab#>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX ldp: <http://www.w3.org/ns/ldp#>
PREFIX sm:   <https://example.org/stigmark#>
PREFIX ui:   <https://example.org/ui#>

# ---------------
# KEY UI-ELEMENTS
# ---------------

# Mark the location of the keys
INSERT {
    GRAPH ?g {
        ?cell ui:hasUiElement ?uiKey .

        ?uiKey ui:konvaType "Circle";
            ui:layer "layer";
            ui:anchor "SE";
            ui:offsetX 0;
            ui:offsetY 0;
            ui:width 12;
            ui:height 12;
            ui:fill ?fill;
            ui:stroke "black";
            ui:strokeWidth 1 .
  }
}
WHERE {
    VALUES (?key ?suffix ?fill) {
        ("greenkey" "#ui-greenkey" "green")
        ("bluekey"  "#ui-bluekey"  "blue")
        ("redkey"   "#ui-redkey"   "red")
    }

    GRAPH ?g {
        ?cell a maze:Cell .

        {
            ?cell dyn:keyValue ?key .
        }
        UNION
        {
            ?keyNode dyn:keyValue ?key .
        }
    }

    BIND(IRI(CONCAT(STR(?cell), ?suffix)) AS ?uiKey)
} ;

# Cleanup key UI elements when keys are no longer present
DELETE {
    GRAPH ?g {
        ?cell ui:hasUiElement ?uiKey .
        ?uiKey ?p ?o .
    }
}
WHERE {
    VALUES (?key ?suffix) {
        ("greenkey" "#ui-greenkey")
        ("bluekey"  "#ui-bluekey")
        ("redkey"   "#ui-redkey")
    }

    GRAPH ?g {
        ?cell a maze:Cell .
    }

    BIND(IRI(CONCAT(STR(?cell), ?suffix)) AS ?uiKey)

    GRAPH ?g {
        ?uiKey ?p ?o .
    }

    FILTER NOT EXISTS {
        GRAPH ?g {
            {
                ?cell dyn:keyValue ?key .
            }
            UNION
            {
                ?keyNode dyn:keyValue ?key .
            }
        }
    }
} ;

# --------------
# SIGNIFIER ZONE
# --------------

# Route signifiers while the green lock is closed:
# remove the direct route to the lock.

DELETE {
    GRAPH ?g {
        ?cell maze:green ?target .
    }
}
WHERE {
    VALUES ?coords {
        "7/2" "8/2" "9/2" "10/2" "10/3" "11/3" "12/3" "12/4"
    }

    GRAPH ?g {
        ?cell a maze:Cell .
        ?cell maze:green ?target .
    }
    BIND(STRAFTER(STR(?cell), "/cells/") AS ?cellCoords)
    FILTER(?cellCoords = ?coords)

    GRAPH ?lockGraph {
        ?lockCell dyn:state dyn:locked .
    }
    BIND(STRAFTER(STR(?lockCell), "/cells/") AS ?lockCoords)
    FILTER(?lockCoords = "12/5") # greenAction location
} ;

# Route signifiers while the green lock is closed:
# guide the green path via the key.

INSERT {
    GRAPH ?g {
        ?cell maze:green ?target .
    }
}
WHERE {
    VALUES (?coords ?targetCoords) {
        ("7/2"  "7/3")
        ("7/3"  "7/4")
        ("7/4"  "8/4")
        ("8/4"  "8/5")
        ("8/5"  "8/6")
        ("8/6"  "9/6")
        ("9/6"  "10/6")
        ("10/6" "11/6")
        ("11/6" "11/5")
        ("11/5" "12/5")
    }

    GRAPH ?g {
        ?cell a maze:Cell .
    }
    BIND(STRAFTER(STR(?cell), "/cells/") AS ?cellCoords)
    FILTER(?cellCoords = ?coords)

    GRAPH ?targetGraph {
        ?target a maze:Cell .
    }
    BIND(STRAFTER(STR(?target), "/cells/") AS ?actualTargetCoords)
    FILTER(?actualTargetCoords = ?targetCoords)

    GRAPH ?lockGraph {
        ?lockCell dyn:state dyn:locked .
    }
    BIND(STRAFTER(STR(?lockCell), "/cells/") AS ?lockCoords)
    FILTER(?lockCoords = "12/5")
} ;

# Route signifiers after the green lock is open:
# remove the key detour.

DELETE {
    GRAPH ?g {
        ?cell maze:green ?target .
    }
}
WHERE {
    VALUES ?coords {
        "7/2" "7/3" "7/4" "8/4" "8/5" "8/6" "9/6" "10/6" "11/6" "11/5"
    }

    GRAPH ?g {
        ?cell a maze:Cell .
        ?cell maze:green ?target .
    }
    BIND(STRAFTER(STR(?cell), "/cells/") AS ?cellCoords)
    FILTER(?cellCoords = ?coords)

    GRAPH ?lockGraph {
        ?lockCell dyn:state dyn:unlocked .
    }
    BIND(STRAFTER(STR(?lockCell), "/cells/") AS ?lockCoords)
    FILTER(?lockCoords = "12/5")
} ;

# Route signifiers after the green lock is open:
# restore the direct green path to the lock.

INSERT {
    GRAPH ?g {
        ?cell maze:green ?target .
    }
}
WHERE {
    VALUES (?coords ?targetCoords) {
        ("7/2"  "8/2")
        ("8/2"  "9/2")
        ("9/2"  "10/2")
        ("10/2" "10/3")
        ("10/3" "11/3")
        ("11/3" "12/3")
        ("12/3" "12/4")
        ("12/4" "12/5")
    }

    GRAPH ?g {
        ?cell a maze:Cell .
    }
    BIND(STRAFTER(STR(?cell), "/cells/") AS ?cellCoords)
    FILTER(?cellCoords = ?coords)

    GRAPH ?targetGraph {
        ?target a maze:Cell .
    }
    BIND(STRAFTER(STR(?target), "/cells/") AS ?actualTargetCoords)
    FILTER(?actualTargetCoords = ?targetCoords)

    GRAPH ?lockGraph {
        ?lockCell dyn:state dyn:unlocked .
    }
    BIND(STRAFTER(STR(?lockCell), "/cells/") AS ?lockCoords)
    FILTER(?lockCoords = "12/5")
} ;



# Remove Signifiers outside of the signifier-zone
DELETE {
    GRAPH ?g {
        ?cell maze:green ?target .
    }
}
WHERE {
    GRAPH ?g {
        ?cell a maze:Cell .
        ?cell maze:green ?target .
    }
    BIND(STRAFTER(STR(?cell), "/cells/") AS ?coords)
    FILTER(CONTAINS(?coords, "/"))  # keep only /cells/x/y
  
    BIND(xsd:integer(STRBEFORE(?coords, "/")) AS ?x)
    BIND(xsd:integer(STRAFTER(?coords, "/")) AS ?y)
  
    
    FILTER(
        # delete beyond reference cell /cells/12/5
        (?x > 12 || ?y > 5)
        &&
        (?coords NOT IN ("8/6", "9/6", "10/6", "11/6"))
        &&
        # except the mixed zone
        !(
          (
            (
            # Base Frame 1
            (
                ?x > 27 && ?x < 41 &&
                ?y > 13 && ?y < 37
            ) ||
            # Base Frame 2
            (
                ?x >= 22 && 
                ?x <= 27 && 
                ?y >= 12 && 
                ?y <= 16
            )
            ) &&
            # Exclude
            ?coords NOT IN ("40/28", "40/30", "40/36", "28/20", "28/21", "29/21", "28/22", "28/35") 
          )
          # Include
          ||
          ?coords IN ("33/37") 
        )
    )
} ;

# Set Cell Background Color
INSERT {
    GRAPH ?g {
        ?cell ui:hasUiElement ?cellColor .

        ?cellColor ui:layer "cellBackground" ;
                             ui:fill "#e9ffdb" .
    }
}
WHERE {
    GRAPH ?g {
        ?cell a maze:Cell .
    }
    BIND(IRI(CONCAT(STR(?cell), "#ui-bg")) AS ?cellColor)

    # limit to zone
    BIND(STRAFTER(STR(?g), "/cells/") AS ?coords)
    FILTER(CONTAINS(?coords, "/"))  # keep only x/y
  
    BIND(xsd:integer(STRBEFORE(?coords, "/")) AS ?x)
    BIND(xsd:integer(STRAFTER(?coords, "/")) AS ?y)
  
    FILTER(
      (
        # Base Frame
        ?x < 13 &&
        ?y < 19 &&
        # Exclude
        ?coords NOT IN ("12/12", "12/14") 
      )
      # Include
      ||
      ?coords IN ("5/19", "4/19", "13/16", "13/17", "13/18") 
    )
} ;

# --------------
# STIGMERGY ZONE
# --------------

# stigmergy-traffic-increment: increment the counter
DELETE {
    # Remove old quantitative count
    GRAPH ?oldGraph {
        ?subnode sm:quantitative ?count .
    }
}
INSERT {
    # Update existing marker subnode with incremented count
    GRAPH ?oldGraph {
        ?subnode sm:quantitative ?newCount .
    }
}
WHERE {
    # the move event
    GRAPH ?targetGraph {
        ?agent dyn:entersFrom ?oldGraph .
    }

    # find the cell the agent is currently in
    GRAPH ?oldGraph {
        ?oldGraph maze:contains ?agent .

        # ensure marker does already exist
        ?oldGraph sm:hasMarker ?marker .
        
        # find existing subnode for this target
        ?marker sm:contains ?subnode .
        ?subnode sm:refersTo ?targetGraph .
        ?subnode sm:quantitative ?count .
    }

    BIND(?count + 1 AS ?newCount)

    # limit to zone
    BIND(STRAFTER(STR(?oldGraph), "/cells/") AS ?coords)
    FILTER(CONTAINS(?coords, "/"))  # keep only /cells/x/y
  
    BIND(xsd:integer(STRBEFORE(?coords, "/")) AS ?x)
    BIND(xsd:integer(STRAFTER(?coords, "/")) AS ?y)
  
    # starting at cell 13/5 and ending at cell 28/13 plus the mixed zone
    FILTER(
        # Stigmergy Zone
        (
            (
              (
              # Base Frame 1
              (
                  ?x > 12 && ?x < 29 &&
                  ?y < 10
              ) ||
              # Base Frame 2
              (
                  ?x > 20 && ?x < 29 &&
                  ?y >= 10 && ?y < 12
              )
              ) &&
              # Exclude
              ?coords NOT IN ("") 
            )
            # Include
            ||
            ?coords IN ("28/12", "28/13") 
        ) ||
        # Mixed Zone
        (
            (
              (
              # Base Frame 1
              (
                  ?x > 27 && ?x < 41 &&
                  ?y > 13 && ?y < 37
              ) ||
              # Base Frame 2
              (
                  ?x >= 22 && 
                  ?x <= 27 && 
                  ?y >= 12 && 
                  ?y <= 16
              )
              ) &&
              # Exclude
              ?coords NOT IN ("40/28", "40/30", "40/36", "28/20", "28/21", "29/21", "28/22", "28/35") 
            )
            # Include
            ||
            ?coords IN ("33/37") 
        )
    )
} ;

# stigmergy-traffic-add: Add a direction to the existing marker
INSERT {
    # Origin Graph: Stigmergy marker creation
    GRAPH ?oldGraph {
        ?marker sm:contains _:node .
        _:node sm:refersTo ?targetGraph .
        _:node sm:quantitative 1 .
    }
}
WHERE {
    # the move event
    GRAPH ?targetGraph {
        ?agent dyn:entersFrom ?oldGraph .
    }

    # find the cell the agent is currently in
    GRAPH ?oldGraph {
        ?oldGraph maze:contains ?agent .

        # ensure marker does already exist
        ?oldGraph sm:hasMarker ?marker .
    }

    # ensure NO subnode for this target exists yet
    FILTER NOT EXISTS {
        GRAPH ?oldGraph{
            ?marker sm:contains ?anyNode .
            ?anyNode sm:refersTo ?targetGraph .
        }
    }  
    # limit to zone
    BIND(STRAFTER(STR(?oldGraph), "/cells/") AS ?coords)
    FILTER(CONTAINS(?coords, "/"))  # keep only /cells/x/y
  
    BIND(xsd:integer(STRBEFORE(?coords, "/")) AS ?x)
    BIND(xsd:integer(STRAFTER(?coords, "/")) AS ?y)
  
    # starting at cell 13/5 and ending at cell 28/13 plus the mixed zone
    FILTER(
        # Stigmergy Zone
        (
            (
              (
              # Base Frame 1
              (
                  ?x > 12 && ?x < 29 &&
                  ?y < 10
              ) ||
              # Base Frame 2
              (
                  ?x > 20 && ?x < 29 &&
                  ?y >= 10 && ?y < 12
              )
              ) &&
              # Exclude
              ?coords NOT IN ("") 
            )
            # Include
            ||
            ?coords IN ("28/12", "28/13") 
        ) ||
        # Mixed Zone
        (
            (
              (
              # Base Frame 1
              (
                  ?x > 27 && ?x < 41 &&
                  ?y > 13 && ?y < 37
              ) ||
              # Base Frame 2
              (
                  ?x >= 22 && 
                  ?x <= 27 && 
                  ?y >= 12 && 
                  ?y <= 16
              )
              ) &&
              # Exclude
              ?coords NOT IN ("40/28", "40/30", "40/36", "28/20", "28/21", "29/21", "28/22", "28/35") 
            )
            # Include
            ||
            ?coords IN ("33/37") 
        )
    )
} ;

# Stigmergy-traffic-new: Create a marker within the stigmergy-zone. Start at 13/5 until 28/13 
INSERT {
    # Origin Graph: Stigmergy marker creation
    GRAPH ?oldGraph {
        ?oldGraph sm:hasMarker ?newMarker .
        ?newMarker a sm:Marker .
        ?newMarker sm:contains _:node .
        _:node sm:refersTo ?targetGraph .
        _:node sm:quantitative 1 .
    }
}
WHERE {
    # the move event
    GRAPH ?targetGraph {
        ?agent dyn:entersFrom ?oldGraph .
    }

    # find the cell the agent is currently in
    GRAPH ?oldGraph {
        ?oldGraph maze:contains ?agent .
        
        # ensure marker does NOT already exist
        FILTER NOT EXISTS { ?oldGraph sm:hasMarker ?anyMarker }        
    }
    
    # create new marker IRI
    BIND(IRI(CONCAT(STR(?oldGraph), "#marker")) AS ?newMarker)

    # limit to zone
    BIND(STRAFTER(STR(?oldGraph), "/cells/") AS ?coords)
    FILTER(CONTAINS(?coords, "/"))  # keep only /cells/x/y
  
    BIND(xsd:integer(STRBEFORE(?coords, "/")) AS ?x)
    BIND(xsd:integer(STRAFTER(?coords, "/")) AS ?y)
  
    # starting at cell 13/5 and ending at cell 28/13 plus the mixed zone
    FILTER(
        # Stigmergy Zone
        (
            (
              (
              # Base Frame 1
              (
                  ?x > 12 && ?x < 29 &&
                  ?y < 10
              ) ||
              # Base Frame 2
              (
                  ?x > 20 && ?x < 29 &&
                  ?y >= 10 && ?y < 12
              )
              ) &&
              # Exclude
              ?coords NOT IN ("") 
            )
            # Include
            ||
            ?coords IN ("28/12", "28/13") 
        ) ||
        # Mixed Zone
        (
            (
              (
              # Base Frame 1
              (
                  ?x > 27 && ?x < 41 &&
                  ?y > 13 && ?y < 37
              ) ||
              # Base Frame 2
              (
                  ?x >= 22 && 
                  ?x <= 27 && 
                  ?y >= 12 && 
                  ?y <= 16
              )
              ) &&
              # Exclude
              ?coords NOT IN ("40/28", "40/30", "40/36", "28/20", "28/21", "29/21", "28/22", "28/35") 
            )
            # Include
            ||
            ?coords IN ("33/37") 
        )
    )
} ;


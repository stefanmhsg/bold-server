# ----------
# MIXED ZONE
# ----------

# Set Cell Background Color
INSERT {
    GRAPH ?g {
        ?cell ui:hasUiElement ?cellColor .

        ?cellColor ui:layer "cellBackground" ;
                             ui:fill "#ffe4c2" .
    }
}
WHERE {
    GRAPH ?g {
        ?cell a maze:Cell .
    }
    BIND(IRI(CONCAT(STR(?cell), "#ui-bg")) AS ?cellColor)

    # limit to zone
    BIND(STRAFTER(STR(?g), "/cells/") AS ?coords)
    FILTER(CONTAINS(?coords, "/"))  # keep only /cells/x/y
  
    BIND(xsd:integer(STRBEFORE(?coords, "/")) AS ?x)
    BIND(xsd:integer(STRAFTER(?coords, "/")) AS ?y)
  
    # starting at cell 28/14 and ending at cell 36/36 
    FILTER(
      (
        (
        # Base Frame 1
        (
            ?x > 27 && ?x < 41 &&
            ?y > 13 && ?y < 37
        ) ||
        # Base Frame 2
        (
            ?x >= 22 && 
            ?x <= 27 && 
            ?y >= 12 && 
            ?y <= 16
        )
        ) &&
        # Exclude
        ?coords NOT IN ("40/28", "40/30", "40/36", "28/20", "28/21", "29/21", "28/22", "28/35") 
      )
      # Include
      ||
      ?coords IN ("33/37") 
    )
} ;

# ----------
# FINAL ZONE
# ----------

# Set Cell Background Color
INSERT {
    GRAPH ?g {
        ?cell ui:hasUiElement ?cellColor .

        ?cellColor ui:layer "cellBackground" ;
                             ui:fill "#ffc2c8" .
    }
}
WHERE {
    GRAPH ?g {
        ?cell a maze:Cell .
    }
    BIND(IRI(CONCAT(STR(?cell), "#ui-bg")) AS ?cellColor)

    # limit to zone
    BIND(STRAFTER(STR(?g), "/cells/") AS ?coords)
    FILTER(CONTAINS(?coords, "/"))  # keep only /cells/x/y
  
    BIND(xsd:integer(STRBEFORE(?coords, "/")) AS ?x)
    BIND(xsd:integer(STRAFTER(?coords, "/")) AS ?y)
  
    # starting at cell 36/37 and ending at cell 54/58 
    FILTER(
      (
        (
        # Base Frame 1
        (
            ?x > 39 &&
            ?y > 27
        ) ||
        # Base Frame 2
        (
            ?x >= 31 && 
            ?x <= 39 && 
            ?y >= 38 && 
            ?y <= 44
        )
        ) &&
        # Exclude
        ?coords NOT IN ("40/33") 
      )
      # Include
      ||
      ?coords IN ("36/37") 
    )
} 



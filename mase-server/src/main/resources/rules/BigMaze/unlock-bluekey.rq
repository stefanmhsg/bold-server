PREFIX maze: <https://kaefer3000.github.io/2021-02-dagstuhl/vocab#>
PREFIX dyn: <https://paul.ti.rw.fau.de/~am52etar/dynmaze/dynmaze#>
PREFIX http: <http://www.w3.org/2011/http#>

# Unlock cell with blue key /28/13 - leads to cell 28/14
DELETE {
  GRAPH ?g {
    # remove old state of this lock
    ?cell dyn:state ?oldState .

    # remove any old status on this action
    ?blueAction dyn:hasStatus ?oldStatus .
  }
}
INSERT {
  GRAPH ?g {
    # ensure the door to the east is present
    ?cell maze:east <http://127.0.1.1:8080/cells/28/14> .
    ?cell maze:green <http://127.0.1.1:8080/cells/28/14> .

    # new state for the cell
    ?cell dyn:state dyn:unlocked .

    # mark the action as done
    ?blueAction dyn:hasStatus dyn:done .
  }
}
WHERE {
  GRAPH ?g {
    ?cell a maze:Cell , dyn:Lock ;
          dyn:keyValue "bluekey" ;
          dyn:needsAction ?blueAction .

    ?blueAction dyn:hasStatus dyn:open ;
               http:body ?body .

    ?body dyn:foundAt dyn:BlueKey .

    OPTIONAL { ?cell dyn:state ?oldState . }
    OPTIONAL { ?blueAction dyn:hasStatus ?oldStatus . }
  }
}
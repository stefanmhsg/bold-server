PREFIX ui:   <https://example.org/ui#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX stig: <https://example.org/stigmark#>
PREFIX maze: <https://kaefer3000.github.io/2021-02-dagstuhl/vocab#>

# -----------------
# STIGMERGY MARKERS
# -----------------

# Project stigmergy markers to a visual footstep Path UI element.
# This keeps marker semantics in RDF while exposing only a render projection.
DELETE {
    GRAPH ?g {
        ?footUi ui:opacity ?oldOpacity .
        ?footUi ui:scaleX ?oldScaleX .
        ?footUi ui:scaleY ?oldScaleY .
        ?footUi ui:direction ?oldDirection .
        ?footUi ui:anchor ?oldAnchor .
        ?footUi ui:offsetX ?oldOffsetX .
        ?footUi ui:offsetY ?oldOffsetY .
    }
}
INSERT {
    GRAPH ?g {
        ?cell ui:hasUiElement ?footUi .

        ?footUi ui:konvaType "Path" ;
                ui:layer "layer" ;
                ui:anchor "C" ;
                ui:offsetX ?offsetX ;
                ui:offsetY ?offsetY ;
                ui:data "M13 34 C13 25 31 25 33 34 C37 48 36 64 33 72 C30 79 14 79 11 72 C8 64 16 48 13 34 Z M19 19 A4.5 4.5 0 1 0 10 19 A4.5 4.5 0 1 0 19 19 Z M25 13 A3.6 3.6 0 1 0 17.8 13 A3.6 3.6 0 1 0 25 13 Z M31 15 A3.2 3.2 0 1 0 24.6 15 A3.2 3.2 0 1 0 31 15 Z M36.6 21 A2.8 2.8 0 1 0 31 21 A2.8 2.8 0 1 0 36.6 21 Z M40.4 29 A2.4 2.4 0 1 0 35.6 29 A2.4 2.4 0 1 0 40.4 29 Z" ;
                ui:fill "#111111" ;
                ui:stroke "#111111" ;
                ui:strokeWidth 0.5 ;
                ui:scaleX ?scale ;
                ui:scaleY ?scale ;
                ui:direction ?direction ;
                ui:opacity ?opacity .
    }
}
WHERE {
    GRAPH ?g {
        ?cell a maze:Cell ;
              stig:hasMarker ?marker .

        ?marker a stig:Marker ;
                stig:contains ?entry .

        ?entry stig:quantitative ?q .

        OPTIONAL { ?entry stig:refersTo ?target . }
        OPTIONAL { ?cell maze:north ?northCell . }
        OPTIONAL { ?cell maze:east ?eastCell . }
        OPTIONAL { ?cell maze:south ?southCell . }
        OPTIONAL { ?cell maze:west ?westCell . }
    }

    BIND(xsd:decimal(?q) AS ?qDec)

    BIND(
        IF(BOUND(?target) && BOUND(?northCell) && ?target = ?northCell, "N",
           IF(BOUND(?target) && BOUND(?eastCell) && ?target = ?eastCell, "E",
              IF(BOUND(?target) && BOUND(?southCell) && ?target = ?southCell, "S",
                 IF(BOUND(?target) && BOUND(?westCell) && ?target = ?westCell, "W", "E"))))
        AS ?direction
    )

    BIND(IRI(CONCAT(STR(?cell), "#ui-footstep", ?direction)) AS ?footUi)

    # Anchor at center and shift toward door direction.
    # The footprint is vertically elongated, so Y shift is slightly smaller than X.
    BIND(IF(?direction = "E", 30, IF(?direction = "W", -30, 0)) AS ?offsetX)
    BIND(IF(?direction = "S", 30, IF(?direction = "N", -30, 0)) AS ?offsetY)

    OPTIONAL {
        SELECT ?g ?cell ?marker ?entry (COUNT(DISTINCT ?qHigherDec) AS ?higherDistinctCount)
        WHERE {
            GRAPH ?g {
                ?cell stig:hasMarker ?marker .
                ?marker stig:contains ?entry .
                ?entry stig:quantitative ?qSelf .

                ?marker stig:contains ?entryHigher .
                ?entryHigher stig:quantitative ?qHigher .
            }

            BIND(xsd:decimal(?qSelf) AS ?qSelfDec)
            BIND(xsd:decimal(?qHigher) AS ?qHigherDec)
            FILTER(?qHigherDec > ?qSelfDec)
        }
        GROUP BY ?g ?cell ?marker ?entry
    }

    # Dense rank by quantitative value inside the marker (ties share same rank).
    BIND(COALESCE(?higherDistinctCount, 0) + 1 AS ?rank)

    # Slightly reduced size to keep footprints visually inside the 3x3 target zones.
    BIND(IF(?qDec >= 5, 0.42, IF(?qDec >= 3, 0.34, 0.27)) AS ?scale)
    BIND(IF(?rank = 1, 1.00, IF(?rank = 2, 0.75, IF(?rank = 3, 0.50, 0.25))) AS ?opacity)

    OPTIONAL {
        GRAPH ?g {
            ?footUi ui:opacity ?oldOpacity .
            ?footUi ui:scaleX ?oldScaleX .
            ?footUi ui:scaleY ?oldScaleY .
            ?footUi ui:direction ?oldDirection .
            ?footUi ui:anchor ?oldAnchor .
            ?footUi ui:offsetX ?oldOffsetX .
            ?footUi ui:offsetY ?oldOffsetY .
        }
    }
};

# Remove previously projected footstep UI elements that no longer have a marker backing.
DELETE {
    GRAPH ?g {
        ?cell ui:hasUiElement ?footUi .
        ?footUi ?p ?o .
    }
}
WHERE {
    GRAPH ?g {
        ?cell ui:hasUiElement ?footUi .
        ?footUi ui:konvaType "Path" .
    }

    FILTER CONTAINS(STR(?footUi), "#ui-footstep")

    FILTER NOT EXISTS {
        GRAPH ?g {
            ?cell stig:hasMarker ?marker .
            ?marker stig:contains ?entry .
            OPTIONAL { ?entry stig:refersTo ?target . }
            OPTIONAL { ?cell maze:north ?northCell . }
            OPTIONAL { ?cell maze:east ?eastCell . }
            OPTIONAL { ?cell maze:south ?southCell . }
            OPTIONAL { ?cell maze:west ?westCell . }
        }

        BIND(
            IF(BOUND(?target) && BOUND(?northCell) && ?target = ?northCell, "N",
               IF(BOUND(?target) && BOUND(?eastCell) && ?target = ?eastCell, "E",
                  IF(BOUND(?target) && BOUND(?southCell) && ?target = ?southCell, "S",
                     IF(BOUND(?target) && BOUND(?westCell) && ?target = ?westCell, "W", "E"))))
            AS ?expectedDirection
        )
        BIND(IRI(CONCAT(STR(?cell), "#ui-footstep", ?expectedDirection)) AS ?expectedFootUi)
        FILTER(?expectedFootUi = ?footUi)
    }

    GRAPH ?g {
        ?footUi ?p ?o .
    }
}

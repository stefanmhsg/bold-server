PREFIX dyn: <https://paul.ti.rw.fau.de/~am52etar/dynmaze/dynmaze#>

# Remove all already-observed move success events.
# This rule must run after unlock* and before move*, so re-lock rules can react
# to the previous transaction's event before the current transaction creates one.
DELETE {
  GRAPH ?g {
    ?moveEvent ?predicate ?object .
  }
}
WHERE {
  GRAPH ?g {
    ?moveEvent a dyn:moveSuccessEvent ;
               ?predicate ?object .
  }
}

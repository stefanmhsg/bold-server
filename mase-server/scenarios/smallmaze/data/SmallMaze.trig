@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix ldp: <http://www.w3.org/ns/ldp#> .
@prefix maze: <https://kaefer3000.github.io/2021-02-dagstuhl/vocab#> .
@prefix xhv: <http://www.w3.org/1999/xhtml/vocab#> .
@prefix http: <http://www.w3.org/2011/http#> .
@prefix httpm: <http://www.w3.org/2011/http-methods#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix dyn: <https://paul.ti.rw.fau.de/~am52etar/dynmaze/dynmaze#> .
@prefix ui: <https://example.org/ui#> .
@prefix stig: <https://example.org/stigmark#> .

#define the root of our scenario, where the maze exists
</maze> {
    </maze> a ldp:BasicContainer ;
        a maze:SmallMaze ; 
        ldp:contains </map> ;
        xhv:start </cells/0/0> .
}

#counter for steps
</counter> {
    </counter>  a maze:Counter; 
                rdf:value 0 .
}

#the colors for stations and products
</colors> {
    maze:green a maze:Color .
}

# map of maze
</map> {

    </map> a maze:Map.

    </cells/999> a maze:Cell ;
        rdfs:label "Exit";
        maze:north  maze:Wall;
        maze:west   maze:Wall;
        maze:south  maze:Wall;
        maze:east   maze:Wall.

    </cells/0/0> a maze:Cell ;
        rdfs:label "Entrance Hallway";
        maze:north maze:Wall ;
        maze:west  maze:Wall ;
        maze:south maze:Wall ;
        maze:east </cells/0/1> . 


    </cells/0/1> a maze:Cell ;
        rdfs:label "Kitchen";
        maze:north maze:Wall ;
        maze:west </cells/0/0> ;
        maze:south maze:Wall ;
        maze:east </cells/0/2> . 

    </cells/0/2> a maze:Cell ;
        rdfs:label "Nursery";
        maze:north maze:Wall ;
        maze:west  </cells/0/1> ;
        maze:south </cells/1/2> ;
        maze:east  maze:Wall .

    </cells/1/2> a maze:Cell ;
        rdfs:label "Laundry Room";
        maze:north </cells/0/2> ;
        maze:west  maze:Wall ;
        maze:south maze:Wall ;
        maze:east  </cells/1/3> .

    </cells/1/3> a maze:Cell ;
        rdfs:label "Hobby Room";
        maze:north maze:Wall ;
        maze:west  </cells/1/2> ;
        maze:south maze:Wall ;
        maze:east  </cells/1/4> .

    </cells/1/4> a maze:Cell ;
        rdfs:label "Garage";
        maze:north  </cells/0/4>;
        maze:west   </cells/1/3>;
        maze:south  </cells/2/4>;
        maze:east  maze:Wall .

    </cells/0/4> a maze:Cell ;
        rdfs:label "Servant's Quarters";
        maze:north  maze:Wall;
        maze:west   </cells/0/3>;
        maze:south  </cells/1/4>;
        maze:east  maze:Wall .

    </cells/0/3> a maze:Cell ;
        rdfs:label "Standing Room";
        maze:north  maze:Wall;
        maze:west   maze:Wall;
        maze:south  maze:Wall;
        maze:east   </cells/0/4>.

    </cells/2/4> a maze:Cell ;
        rdfs:label "Tool Room";
        maze:north  </cells/1/4>;
        maze:west   </cells/2/3>;
        maze:south  maze:Wall;
        maze:east   maze:Wall.

    </cells/2/3> a maze:Cell ;
        rdfs:label "Observatory";
        maze:north  maze:Wall;
        maze:west   maze:Wall;
        maze:south  </cells/3/3>;
        maze:east   </cells/2/4>.

    </cells/3/3> a maze:Cell ;
        rdfs:label "Hot House";
        maze:north  </cells/2/3>;
        maze:west   maze:Wall;
        maze:south  </cells/4/3>;
        maze:east   maze:Wall.

    </cells/4/3> a maze:Cell ;
        rdfs:label "Guest Room";
        maze:north  </cells/3/3>;
        maze:west   </cells/4/2>;
        maze:south  maze:Wall;
        maze:east   </cells/4/4>.

    </cells/4/2> a maze:Cell ;
        rdfs:label "Sitting Room";
        maze:north  </cells/3/2>;
        maze:west   maze:Wall;
        maze:south  maze:Wall;
        maze:east   </cells/4/3>.

    </cells/4/4> a maze:Cell ;
        rdfs:label "Spoon Storage";
        maze:north  </cells/3/4>;
        maze:west   </cells/4/3>;
        maze:exit  </cells/999>;
        maze:east   maze:Wall.

    </cells/3/4> a maze:Cell ;
        rdfs:label "Banquet Hall";
        maze:north  maze:Wall;
        maze:west   maze:Wall;
        maze:south  </cells/4/4>;
        maze:east   maze:Wall.


    </cells/3/2> a maze:Cell ;
        rdfs:label "Dining Room";
        maze:north  maze:Wall;
        maze:west   </cells/3/1>;
        maze:south  </cells/4/2>;
        maze:east   maze:Wall.

    </cells/3/1> a maze:Cell ;
        rdfs:label "Fruit Closet";
        maze:north  maze:Wall;
        maze:west   maze:Wall;
        maze:south  </cells/4/1>;
        maze:east   </cells/3/2>.


    </cells/4/1> a maze:Cell ;
        rdfs:label "Den of Forks";
        maze:north  </cells/3/1>;
        maze:west   </cells/4/0>;
        maze:south  maze:Wall;
        maze:east   maze:Wall.


    </cells/4/0> a maze:Cell ;
        rdfs:label "Pantry";
        maze:north  </cells/3/0>;
        maze:west   maze:Wall;
        maze:south  maze:Wall;
        maze:east   </cells/4/1>.

   </cells/3/0> a maze:Cell ;
        rdfs:label "Trophy Room";
        maze:north  </cells/2/0>;
        maze:west   maze:Wall;
        maze:south  </cells/4/0>;
        maze:east   maze:Wall.


    </cells/2/0> a maze:Cell ;
        rdfs:label "Library";
        maze:north  maze:Wall;
        maze:west   maze:Wall;
        maze:south  </cells/3/0>;
        maze:east   </cells/2/1>.

    </cells/2/1> a maze:Cell ;
        rdfs:label "Master Bedroom";
        maze:north  </cells/1/1>;
        maze:west   </cells/2/0>;
        maze:south  maze:Wall;
        maze:east   </cells/2/2>.


    </cells/2/2> a maze:Cell ;
        rdfs:label "Smoking Room";
        maze:north  maze:Wall;
        maze:west   </cells/2/1>;
        maze:south  maze:Wall;
        maze:east   maze:Wall.

    </cells/1/1> a maze:Cell ;
        rdfs:label "Cloak Room";
        maze:north  maze:Wall;
        maze:west   </cells/1/0>;
        maze:south  </cells/2/1>;
        maze:east   maze:Wall.


    </cells/1/0> a maze:Cell ;
        rdfs:label "Hall of Knives";
        maze:north  maze:Wall;
        maze:west   maze:Wall;
        maze:south  maze:Wall;
        maze:east   </cells/1/1>.

}

#the URIs for all used transporters
</cells> {
    </cells> a ldp:BasicContainer ;
        ldp:contains </cells/0/0>,
                     </cells/0/1>,
                     </cells/0/2>,
                     </cells/0/3>,
                     </cells/0/4>,
                     </cells/1/0>,
                     </cells/1/1>,
                     </cells/1/2>, 
                     </cells/1/3>,
                     </cells/1/4>,
                     </cells/2/0>,
                     </cells/2/1>,
                     </cells/2/2>,
                     </cells/2/3>,
                     </cells/2/4>,
                     </cells/3/0>,
                     </cells/3/1>,
                     </cells/3/2>,
                     </cells/3/3>,
                     </cells/3/4>,
                     </cells/4/0>,
                     </cells/4/1>,
                     </cells/4/2>,
                     </cells/4/3>,
                     </cells/4/4> .
}

#initial information about cells 

#NWSE
#0/0    0/1    0/2    0/3    0/4
#        |              |
#1/0    1/1    1/2    1/3    1/4
#        |              |
#2/0    2/1    2/2    2/3    2/4
#|               |
#3/0    3/1    3/2    3/3    3/4
#|      |      |      |      |
#4/0    4/1    4/2    4/3    4/4
#                         --> Exit


#NAMED_GRAPHS_START
</cells/999> {
    </cells/999> a maze:Cell ;
        rdfs:label "Exit";
        maze:north  maze:Wall;
        maze:west   maze:Wall;
        maze:south  maze:Wall;
        maze:east   maze:Wall.
}


</cells/0/0> {
    </cells/0/0> a maze:Cell ;
        rdfs:label "Entrance Hallway";
        dyn:hasKey  </cells/0/0#key> ;
        dyn:hasKey  </cells/0/0#key2> ;
        maze:north maze:Wall ;
        maze:west  maze:Wall ;
        maze:south maze:Wall ;
        maze:green </cells/0/1> ;
        maze:east </cells/0/1> .

    </cells/0/0#key2> a dyn:RedKey;
        dyn:keyValue "redkey" .
}

</cells/0/1> {
    <http://127.0.1.1:8080/cells/0/1> a maze:Cell, dyn:Lock ;
        rdfs:label "Kitchen";
        maze:north maze:Wall ;
        maze:west </cells/0/0> ;
        maze:south maze:Wall ;
        dyn:needsAction <http://127.0.1.1:8080/cells/0/1#redAction> ; 
        dyn:state dyn:locked .

    <http://127.0.1.1:8080/cells/0/1#redAction> dyn:hasStatus dyn:open ;
            http:requestURI <http://127.0.1.1:8080/cells/0/1>; #where to perform the action
            http:mthd httpm:POST; #how to enact the action
            http:body [ 
                dyn:foundAt dyn:RedKey ; #tells us where (in terms of class) to find an information
                dyn:needsProperty dyn:keyValue #tells us what information we are looking for
            ] .

}


</cells/0/2> {
    </cells/0/2> a maze:Cell ;
        rdfs:label "Nursery";
        maze:north maze:Wall ;
        maze:west  </cells/0/1> ; 
        maze:green </cells/1/2> ;
        maze:south </cells/1/2> ;
        maze:east  maze:Wall .
}

</cells/1/2> {
    </cells/1/2> a maze:Cell ;
        rdfs:label "Laundry Room";
        maze:north </cells/0/2> ;
        maze:west  maze:Wall ;
        maze:south maze:Wall ;
        maze:green </cells/1/3> ;
        maze:east  </cells/1/3> .
}

</cells/1/3> {
    </cells/1/3> a maze:Cell ;
        rdfs:label "Hobby Room";
        maze:north maze:Wall ;
        maze:west  </cells/1/2> ;
        maze:south maze:Wall ;
        maze:green </cells/1/4> ;
        maze:east  </cells/1/4> .
}

</cells/1/4> {
    </cells/1/4> a maze:Cell ;
        rdfs:label "Garage";
        maze:north  </cells/0/4>;
        maze:west   </cells/1/3>;
        maze:green </cells/2/4> ;
        maze:south  </cells/2/4>;
        maze:east  maze:Wall .
}

</cells/0/4> {
    </cells/0/4> a maze:Cell ;
        rdfs:label "Servant's Quarters";
        maze:north  maze:Wall;
        maze:west   </cells/0/3>;
        maze:south  </cells/1/4>;
        maze:east  maze:Wall .
}

</cells/0/3> {
    </cells/0/3> a maze:Cell ;
        rdfs:label "Standing Room";
        maze:north  maze:Wall;
        maze:west   maze:Wall;
        maze:south  maze:Wall;
        maze:east   </cells/0/4>.
}

</cells/2/4> {
    </cells/2/4> a maze:Cell ;
        rdfs:label "Tool Room";
        maze:north  </cells/1/4>;
        maze:green </cells/2/3> ;
        maze:west   </cells/2/3>;
        maze:south  maze:Wall;
        maze:east   maze:Wall.
}

</cells/2/3> {
    </cells/2/3> a maze:Cell ;
        dyn:hasKey  </cells/2/3#key> ;
        rdfs:label "Observatory";
        maze:north  maze:Wall;
        maze:west   maze:Wall;
        maze:green </cells/3/3> ;
        maze:south  </cells/3/3>;
        maze:east   </cells/2/4>.

    </cells/2/3#key> a dyn:GreenKey;
        dyn:fitsInLock </cells/3/3> ;
        dyn:keyValue "greenkey" .
}

</cells/3/3> {
    </cells/3/3> a dyn:Lock, maze:Cell ;
        rdfs:label "Hot House";
        maze:north  </cells/2/3>;
        maze:west   maze:Wall;
        maze:east   maze:Wall;
        dyn:needsAction <http://127.0.1.1:8080/cells/3/3#greenAction>;
        dyn:state dyn:locked .

    <http://127.0.1.1:8080/cells/3/3#greenAction> dyn:hasStatus dyn:open ;
        http:requestURI <http://127.0.1.1:8080/cells/3/3>;
        http:mthd httpm:POST;
        http:body [ 
            dyn:foundAt dyn:GreenKey ; 
            dyn:needsProperty dyn:keyValue 
        ] .
}


</cells/4/3> {
    </cells/4/3> a maze:Cell ;
        rdfs:label "Guest Room";
        maze:north  </cells/3/3>;
        maze:west   </cells/4/2>;
        maze:south  maze:Wall;
        maze:green </cells/4/4> ;
        maze:east   </cells/4/4>.
}

</cells/4/2> {
    </cells/4/2> a maze:Cell ;
        rdfs:label "Sitting Room";
        maze:north  </cells/3/2>;
        maze:west   maze:Wall;
        maze:south  maze:Wall;
        maze:east   </cells/4/3>.
}

</cells/4/4> {
    </cells/4/4> a maze:Cell ;
        rdfs:label "Spoon Storage";
        maze:north  </cells/3/4>;
        maze:west   </cells/4/3>;
        maze:exit  </cells/999>;
        maze:east   maze:Wall.
}

</cells/3/4> {
    </cells/3/4> a maze:Cell ;
        rdfs:label "Banquet Hall";
        maze:north  maze:Wall;
        maze:west   maze:Wall;
        maze:south  </cells/4/4>;
        maze:east   maze:Wall.
}

</cells/3/2> {
    </cells/3/2> a maze:Cell ;
        rdfs:label "Dining Room";
        maze:north  maze:Wall;
        maze:west   </cells/3/1>;
        maze:south  </cells/4/2>;
        maze:east   maze:Wall.
}

</cells/3/1> {
    </cells/3/1> a maze:Cell ;
        rdfs:label "Fruit Closet";
        maze:north  maze:Wall;
        maze:west   maze:Wall;
        maze:south  </cells/4/1>;
        maze:east   </cells/3/2>.
}

</cells/4/1> {
    </cells/4/1> a maze:Cell ;
        rdfs:label "Den of Forks";
        maze:north  </cells/3/1>;
        maze:west   </cells/4/0>;
        maze:south  maze:Wall;
        maze:east   maze:Wall.
}

</cells/4/0> {
    </cells/4/0> a maze:Cell ;
        rdfs:label "Pantry";
        maze:north  </cells/3/0>;
        maze:west   maze:Wall;
        maze:south  maze:Wall;
        maze:east   </cells/4/1>.
}

</cells/3/0> {
    </cells/3/0> a maze:Cell ;
        rdfs:label "Trophy Room";
        maze:north  </cells/2/0>;
        maze:west   maze:Wall;
        maze:south  </cells/4/0>;

}

</cells/2/0> {
    </cells/2/0> a maze:Cell ;
        rdfs:label "Library";
        maze:north  maze:Wall;
        maze:west   maze:Wall;
        maze:south  </cells/3/0>;
        maze:east   </cells/2/1>.
}

</cells/2/1> {
    </cells/2/1> a maze:Cell ;
        rdfs:label "Master Bedroom";
        maze:north  </cells/1/1>;
        maze:west   </cells/2/0>;
        maze:south  maze:Wall;

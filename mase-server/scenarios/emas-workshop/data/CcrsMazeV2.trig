# </cells/12/5> { </cells/12/5> a maze:Cell, dyn:Lock ; dyn:needsAction <http://127.0.1.1:8080/cells/12/5#greenAction>; maze:north </cells/11/5>; maze:west </cells/12/4>; maze:east maze:Wall . # maze:south  </cells/13/5>; maze:green </cells/13/5> 
#  <http://127.0.1.1:8080/cells/12/5#greenAction> dyn:hasStatus dyn:open ;
#         http:requestURI <http://127.0.1.1:8080/cells/12/5>;
#         http:mthd httpm:POST;
#         http:body [ 
#             dyn:foundAt dyn:GreenKey ; 
#             dyn:needsProperty dyn:keyValue 
#         ] .
# }

</cells/12/5> { </cells/12/5> a maze:Cell, dyn:Lock ; hydra:operation <http://127.0.1.1:8080/cells/12/5#greenAction> ; maze:north </cells/11/5>; maze:west </cells/12/4>; maze:east maze:Wall . # maze:south  </cells/13/5>; maze:green </cells/13/5> 
 <http://127.0.1.1:8080/cells/12/5#greenAction> a hydra:Operation ;
        hydra:method "POST" ;
        hydra:target <http://127.0.1.1:8080/cells/12/5> ;
        hydra:expects dyn:GreenKeyBodyShape ;
        hydra:returns dyn:UnlockedLock ;
        dyn:acceptsKeyType dyn:GreenKey ;
        dyn:hasStatus dyn:open .

 dyn:GreenKeyBodyShape
        a sh:NodeShape ;
        sh:targetNode <http://127.0.1.1:8080/cells/12/5> ;
        sh:property [
            sh:path dyn:keyValue ;
            sh:datatype xsd:string ;
            sh:minCount 1 ;
        ] .
}


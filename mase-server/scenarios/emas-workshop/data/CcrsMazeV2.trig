#define the root of our scenario, where the maze exists
# sequence lenghth 13520562
</maze> {
    </maze> a ldp:BasicContainer , maze:CcrsMaze ;
        maze:transitions maze:north, maze:south, maze:east, maze:west , maze:exit ;
        ldp:contains </map> ;
        xhv:start </cells/0> .
}

#counter for steps
</counter> {
    </counter>  a maze:Counter; 
                rdf:value 0 .
}

#the colors for stations and products
</colors> {
    maze:green a maze:Color .
}



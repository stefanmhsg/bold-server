# Rule to unlock doors when red key is found
PREFIX http: <http://www.w3.org/2011/http#>
PREFIX dyn: <https://paul.ti.rw.fau.de/~am52etar/dynmaze/dynmaze#>
PREFIX maze: <https://kaefer3000.github.io/2021-02-dagstuhl/vocab#>

DELETE {
  GRAPH ?g {
    # remove old state of this lock
    ?cell dyn:state ?oldState .

    # remove any old status on this action
    ?redAction dyn:hasStatus ?oldStatus .
  }
}
INSERT {
  GRAPH ?g {
    # ensure the door to the east is present
    ?cell maze:east <http://127.0.1.1:8080/cells/10> .

    # new state for the cell
    ?cell dyn:state dyn:unlocked .

    # mark the action as done
    ?redAction dyn:hasStatus dyn:done .
  }
}
WHERE {
  GRAPH ?g {
    ?cell a maze:Cell , dyn:Lock ;
          dyn:keyValue "redkey" ;
          dyn:needsAction ?redAction .

    ?redAction dyn:hasStatus dyn:open ;
               http:body ?body .

    ?body dyn:foundAt dyn:RedKey .

    OPTIONAL { ?cell dyn:state ?oldState . }
    OPTIONAL { ?redAction dyn:hasStatus ?oldStatus . }
  }
}
